{
  "name": "@horusship/sdk",
  "version": "0.1.1",
  "description": "Official TypeScript SDK for the Horus API (horusship.com)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./catalog": {
      "import": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      },
      "require": {
        "types": "./dist/catalog.d.cts",
        "default": "./dist/catalog.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "horus",
    "ebay",
    "amazon",
    "arbitrage",
    "sdk",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HorusShip/horus-node.git"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "sync-spec": "curl -fsSL https://horusship.com/api/v1/openapi.json -o openapi/openapi.json"
  },
  "homepage": "https://github.com/HorusShip/horus-node#readme",
  "bugs": {
    "url": "https://github.com/HorusShip/horus-node/issues"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
